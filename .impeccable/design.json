    {
      "name": "Download for Windows",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary filled download link; the release destination is a real link.",
      "html": "<a class=\"ds-primary\" href=\"https://github.com/Cyronius/based/releases/latest\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"m2 4 9-1v8H2Zm11-1 9-1v9h-9ZM2 13h9v8l-9-1Zm11 0h9v9l-9-1Z\"/></svg>Download for Windows</a>",
      "css": ".ds-primary{font-family:Inter,sans-serif;font-size:13px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:11px;min-height:46px;padding:0 20px;border-radius:10px;white-space:nowrap;background:var(--action,#0a3327);color:var(--white,#fff);box-shadow:0 4px 10px #113b3212;text-decoration:none;transition:background .18s ease-out,transform .18s ease-out}.ds-primary:hover{background:var(--action-hover,#174d39);transform:translateY(-1px)}.ds-primary:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}@media(prefers-reduced-motion:reduce){button,a{transition:none;animation:none}}"
    },
    {
      "name": "macOS preview",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined secondary platform download link.",
      "html": "<a class=\"ds-secondary\" href=\"https://github.com/Cyronius/based/releases/latest\">macOS preview</a>",
      "css": ".ds-secondary{font-family:Inter,sans-serif;font-size:13px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 20px;border-radius:10px;white-space:nowrap;box-shadow:inset 0 0 0 1px #7da998;background:transparent;color:var(--ink,#071612);text-decoration:none;transition:background .18s ease-out,transform .18s ease-out}.ds-secondary:hover{background:#c8ebd9;transform:translateY(-1px)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}@media(prefers-reduced-motion:reduce){button,a{transition:none;animation:none}}"
    },
    {
      "name": "New Query",
      "kind": "button",
      "refersTo": "small-button",
      "description": "Compact native-workbench action.",
      "html": "<button class=\"ds-small\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>New Query</button>",
      "css": ".ds-small{font-family:Inter,sans-serif;font-size:12px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:7px 11px;border:1px solid #d3e2dd;border-radius:5px;background:#fbfdfc;color:var(--ink,#071612);white-space:nowrap;cursor:pointer}.ds-small:hover{background:#e2f1e9}.ds-small:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}"
    },
    {
      "name": "Object search",
      "kind": "input",
      "description": "Transparent compact search field from the explorer.",
      "html": "<label class=\"ds-search\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 6 6\"/></svg><input type=\"search\" placeholder=\"Search\" aria-label=\"Search illustrative tables\"></label>",
      "css": ".ds-search{font-family:Inter,sans-serif;display:inline-flex;gap:5px;align-items:center;min-width:0;color:#2b4149}.ds-search input{font-family:Inter,sans-serif;border:0;background:transparent;width:90px;min-width:0;font-size:12px;color:inherit}.ds-search input::placeholder{color:#546b68;opacity:1}.ds-search input:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px;outline-offset:1px}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Compact navigation with a yellow current-section underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-current\" href=\"#workbench\">Workbench</a><a href=\"https://github.com/Cyronius/based#guide\">Guide</a><a href=\"https://github.com/Cyronius/based\">GitHub</a></nav>",
      "css": ".ds-nav{font-family:Inter,sans-serif;display:flex;gap:44px;align-items:center;color:var(--ink,#071612)}.ds-nav a{font-size:14px;font-weight:550;padding:11px 0;position:relative;color:inherit;text-decoration:none;text-underline-offset:5px}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}.ds-current::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:#dace38}"
    },
    {
      "name": "Selected engine tab",
      "kind": "custom",
      "refersTo": "engine-tab-selected",
      "description": "Oversized tab face, skewed lip, and dark rear fold; this isolated sample shows desktop geometry.",
      "html": "<div class=\"ds-engine-stage\"><button class=\"ds-engine\" role=\"tab\" aria-selected=\"true\"><svg width=\"27\" height=\"27\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v14c0 4 16 4 16 0V5M4 10c0 4 16 4 16 0M4 15c0 4 16 4 16 0\"/></svg><span>SQL Server</span></button></div>",
      "css": ".ds-engine-stage{position:relative;padding:4px 40px 0 4px;isolation:isolate}.ds-engine{font-family:Inter,sans-serif;position:relative;display:flex;align-items:center;gap:17px;border:0;border-radius:18px 20px 0 0;height:58px;width:278px;padding:0 24px;font-size:16px;font-weight:600;color:var(--ink,#071612);background:var(--yellow,#fbf7aa);box-shadow:inset 2px 2px 0 #173d2d;text-align:left;z-index:4;cursor:pointer}.ds-engine::after{content:'';position:absolute;right:-16px;top:0;height:100%;width:32px;border-radius:0 13px 0 0;background:inherit;transform:skew(20deg);box-shadow:inset -2px 1px 0 #1e4333;z-index:-1}.ds-engine::before{content:'';position:absolute;right:-30px;top:9px;bottom:0;width:39px;border-radius:0 16px 0 0;background:var(--fold,#245741);transform:skew(23deg);z-index:-2}.ds-engine:hover{background:#fcf7b6}.ds-engine:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}"
    },
    {
      "name": "Selected query tab",
      "kind": "custom",
      "refersTo": "query-tab-selected",
      "description": "Quiet selected tab inside the workbench, with index and visual close mark.",
      "html": "<button class=\"ds-query\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-number\">3</span>High value products (agent)<span class=\"ds-close\" aria-hidden=\"true\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></span></button>",
      "css": ".ds-query{font-family:Inter,sans-serif;display:flex;align-items:center;gap:10px;font-size:12px;white-space:nowrap;padding:0 11px;height:47px;border:0;border-right:1px solid #e6eeeb;flex-shrink:0;background:var(--active,#f7f5c2);border-radius:7px 7px 0 0;color:#17251a;cursor:pointer}.ds-query:hover{background:var(--yellow,#fbf7aa)}.ds-query:focus-visible{outline:3px solid var(--focus,#2a7556);outline-offset:4px}.ds-number{color:#6d817a;font-variant-numeric:tabular-nums}.ds-close{display:inline-flex;align-items:center;justify-content:center;min-width:18px;min-height:22px;border-radius:3px}.ds-close:hover{background:#d0dfce}"
    },
    {
      "name": "Agent query action",
      "kind": "card",
