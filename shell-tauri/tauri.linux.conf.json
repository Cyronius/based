{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["rpm"],
    "category": "DeveloperTool",
    "shortDescription": "AI-first SQL and vector database client",
    "license": "MIT",
    "fileAssociations": [
      {
        "ext": ["sql"],
        "name": "SQL script",
        "mimeType": "application/sql",
        "role": "Editor"
      }
    ],
    "linux": {
      "rpm": {
        "depends": [
          "glibc",
          "gtk3",
          "webkit2gtk4.1",
          "libxdo",
          "libsecret",
          "xdg-utils",
          "libstdc++"
        ],
        "desktopTemplate": "based.desktop.hbs",
        "recommends": ["gnome-keyring"],
        "files": {
          "/usr/share/licenses/based/LICENSE": "../LICENSE"
        }
      }
    }
  }
}
